# Copy this file to .env for local development.
# In production, set these as environment variables in your hosting platform
# (DigitalOcean App Platform → Component → Environment Variables).

# --- Database ---
# Option A: a single connection string (preferred for hosted Postgres).
# DATABASE_URL=postgres://user:password@host:port/dbname
# Option B: individual variables (typical for local dev).
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=stb_security
# Set to "true" when connecting to a hosted Postgres that requires SSL
# (DigitalOcean Managed Postgres requires this).
DB_SSL=true

# --- Auth ---
# Use a long, random string in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# --- Server ---
# Port is provided automatically by App Platform via the PORT env var.
# PORT=3000

# --- CORS ---
# Public URL of the deployed frontend. App Platform exposes each component
# at <component>-<app>.ondigitalocean.app, or you can attach a custom domain.
# Example: https://stb-frontend-xxxxx.ondigitalocean.app
FRONTEND_URL=https://your-frontend-url.ondigitalocean.app
